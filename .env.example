# Copy to .env for local overrides. These are development-only values.
POSTGRES_DB=procureops
POSTGRES_USER=procureops
POSTGRES_PASSWORD=change-me-for-local-development

# For the application running directly on your host:
DATABASE_URL=postgresql+psycopg://procureops:change-me-for-local-development@localhost:5432/procureops
APP_ENV=development
LOG_LEVEL=INFO
